# Copy to .env for local development. Never commit a real .env.

# HTTP port the Nest app listens on.
PORT=3000

# development | production | test
NODE_ENV=development

# Postgres connection string consumed by TypeORM. In Docker Compose this should
# point at the postgres service's hostname (e.g. `db`), not localhost.
DATABASE_URL=postgres://logbook:logbook@localhost:5432/logbook

# Local-disk root for uploaded attachment files (LocalDiskStorageService).
# Swap the storage.module.ts binding for an S3-compatible implementation later
# without changing this variable's meaning (still "where files live").
UPLOAD_DIR=./uploads

# Max accepted upload size, in bytes. Defaults to 25MB — iPhone ProRAW/HEIC
# photos run close to 25MB, which the previous 10MB default rejected.
MAX_UPLOAD_SIZE_BYTES=26214400

# Sign in with Google is the only login method (see src/auth/).
#
# OAuth 2.0 *Web application* client ID from Google Cloud Console (APIs & Services
# -> Credentials). The backend only verifies ID tokens against it (token `aud`
# must equal this value); it is public, not a secret, and the frontend uses the
# same ID. Required, no default.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated e-mail addresses allowed to sign in (case-insensitive). Any
# other verified Google account gets 403. Required, must list at least one.
ALLOWED_EMAILS=you@example.com

# The one user who inherits every entry/photo that existed before accounts (rows
# with no owner), at the moment their account is first created. Optional when
# ALLOWED_EMAILS has exactly one address (that address inherits them); required
# when it has several, or the app refuses to boot. Must be one of ALLOWED_EMAILS.
# LEGACY_OWNER_EMAIL=you@example.com

# How long a session cookie lives before it expires, in days. Renewed
# (slid forward) on use once less than half this TTL remains — see
# src/auth/sessions.service.ts. Deliberately long (default 30 days) so a
# multi-day offline field trip doesn't strand the client's write queue
# behind an expired session at reconnect. Defaults to 30 if unset.
SESSION_TTL_DAYS=30

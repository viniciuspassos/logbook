# Copy to `.env` (ignored by version control) next to docker-compose.yml. Never commit real values.
# Read by `docker compose up`; see docs/INFRASTRUCTURE.md -> "Backend authentication".

# Feature flag for Sign in with Google: true/false (also 1/0). Default false: no
# sign-in route exists, so the API stays closed (every protected route is 401).
# The three variables below are only required when this is true.
GOOGLE_AUTH_ENABLED=false

# OAuth 2.0 "Web application" client ID from Google Cloud Console (APIs & Services
# -> Credentials). Required when GOOGLE_AUTH_ENABLED=true.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated e-mail addresses allowed to sign in. Required when enabled.
ALLOWED_EMAILS=you@example.com

# Which allowlisted user inherits entries/photos that existed before accounts.
# Optional with one allowed address; required with several (when enabled).
# LEGACY_OWNER_EMAIL=you@example.com

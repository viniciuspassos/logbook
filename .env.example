# Copy to `.env` (ignored by version control) next to docker-compose.yml. Never commit real values.
# Read by `docker compose up`; see docs/INFRASTRUCTURE.md -> "Backend authentication".

# OAuth 2.0 "Web application" client ID from Google Cloud Console (APIs & Services
# -> Credentials). Required for the backend to boot.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated e-mail addresses allowed to sign in. Required.
ALLOWED_EMAILS=you@example.com

# Which allowlisted user inherits entries/photos that existed before accounts.
# Optional with one allowed address; required with several.
# LEGACY_OWNER_EMAIL=you@example.com
